<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 https://maven.apache.org/xsd/maven-4.0.0.xsd">
    <modelVersion>4.0.0</modelVersion>

    <parent>
        <groupId>me.stella</groupId>
        <artifactId>capybara-parent</artifactId>
        <version>2026.11</version>
    </parent>

    <artifactId>capybara</artifactId>
    <name>Capybara :: global</name>
    <description>Global module: links core and every NMS version module into the deployable plugin jar.</description>

    <dependencies>
        <dependency>
            <groupId>me.stella</groupId>
            <artifactId>capybara-core</artifactId>
        </dependency>
        <dependency>
            <groupId>me.stella</groupId>
            <artifactId>capybara-nms-1.21.4</artifactId>
            <version>${project.version}</version>
        </dependency>
        <dependency>
            <groupId>me.stella</groupId>
            <artifactId>capybara-nms-1.21.8</artifactId>
            <version>${project.version}</version>
        </dependency>
        <dependency>
            <groupId>me.stella</groupId>
            <artifactId>capybara-nms-1.21.11</artifactId>
            <version>${project.version}</version>
        </dependency>
        <dependency>
            <groupId>me.stella</groupId>
            <artifactId>capybara-nms-1.21.11-folia</artifactId>
            <version>${project.version}</version>
        </dependency>
    </dependencies>

    <build>
        <finalName>Capybara-${project.version}</finalName>
        <resources>
            <resource>
                <directory>src/main/resources</directory>
                <filtering>true</filtering>
                <includes>
                    <include>plugin.yml</include>
                </includes>
            </resource>
            <resource>
                <directory>src/main/resources</directory>
                <filtering>false</filtering>
                <excludes>
                    <exclude>plugin.yml</exclude>
                </excludes>
            </resource>
        </resources>
        <plugins>
            <plugin>
                <groupId>org.apache.maven.plugins</groupId>
                <artifactId>maven-jar-plugin</artifactId>
                <configuration>
                    <archive>
                        <manifest>
                            <mainClass>me.stella.Capybara</mainClass>
                        </manifest>
                        <addMavenDescriptor>false</addMavenDescriptor>
                    </archive>
                </configuration>
            </plugin>
            <plugin>
                <groupId>org.apache.maven.plugins</groupId>
                <artifactId>maven-shade-plugin</artifactId>
                <executions>
                    <execution>
                        <phase>package</phase>
                        <goals>
                            <goal>shade</goal>
                        </goals>
                        <configuration>
                            <createDependencyReducedPom>false</createDependencyReducedPom>
                            <artifactSet>
                                <includes>
                                    <include>me.stella:*</include>
                                </includes>
                            </artifactSet>
                            <filters>
                                <filter>
                                    <artifact>me.stella:*</artifact>
                                    <excludes>
                                        <exclude>META-INF/maven/**</exclude>
                                    </excludes>
                                </filter>
                                <filter>
                                    <!-- module jars only; the manifest comes from this module (see transformer) -->
                                    <artifact>me.stella:capybara-*</artifact>
                                    <excludes>
                                        <exclude>META-INF/MANIFEST.MF</exclude>
                                    </excludes>
                                </filter>
                            </filters>
                            <transformers>
                                <transformer implementation="org.apache.maven.plugins.shade.resource.ManifestResourceTransformer">
                                    <mainClass>me.stella.Capybara</mainClass>
                                </transformer>
                            </transformers>
                        </configuration>
                    </execution>
                </executions>
            </plugin>
        </plugins>
    </build>
</project>
