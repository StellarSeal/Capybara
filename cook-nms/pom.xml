<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 https://maven.apache.org/xsd/maven-4.0.0.xsd">
    <modelVersion>4.0.0</modelVersion>

    <parent>
        <groupId>me.stella</groupId>
        <artifactId>capybara-parent</artifactId>
        <version>2026.11</version>
    </parent>

    <artifactId>capybara-cook-nms</artifactId>
    <packaging>pom</packaging>
    <name>Capybara :: cook-nms</name>
    <description>
        Cooks NMS binaries: starts a server instance for every server distribution (Paperclip / Leaper bundle)
        in libs/dist-server and libs/nms, then fetches the patched binary from versions/ into cook-nms/nms/.
        Skip with -Dcook.skip=true, force a re-cook with -Dcook.force=true.
    </description>

    <properties>
        <cook.skip>false</cook.skip>
        <cook.force>false</cook.force>
    </properties>

    <build>
        <plugins>
            <plugin>
                <groupId>org.codehaus.mojo</groupId>
                <artifactId>exec-maven-plugin</artifactId>
                <executions>
                    <execution>
                        <id>cook-nms</id>
                        <phase>generate-resources</phase>
                        <goals>
                            <goal>exec</goal>
                        </goals>
                        <configuration>
                            <skip>${cook.skip}</skip>
                            <executable>${java.home}/bin/java</executable>
                            <workingDirectory>${project.basedir}</workingDirectory>
                            <arguments>
                                <argument>-Dcook.dir=${project.basedir}</argument>
                                <argument>-Dcook.force=${cook.force}</argument>
                                <argument>${project.basedir}/Cook.java</argument>
                                <argument>${capybara.libs}/dist-server</argument>
                                <argument>${capybara.libs}/nms</argument>
                            </arguments>
                        </configuration>
                    </execution>
                </executions>
            </plugin>
        </plugins>
    </build>
</project>
